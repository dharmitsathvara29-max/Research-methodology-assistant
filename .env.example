# Gemini API Key configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Gmail Automation Configuration (Optional, for emailing PDF reports)
# The application sends from ONE configured sender account to ANY recipient address entered by users.
# End users NEVER need Gmail credentials.
# Use your full Gmail address and a 16-character Google App Password (not your normal password)
# Generated from: Google Account -> Security -> 2-Step Verification -> App Passwords
GMAIL_ADDRESS=your.app.sender@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM_NAME=MethodWise AI
EMAIL_BACKEND=gmail
EMAIL_DAILY_CAP=100
EMAIL_REPLY_TO=noreply@example.com

# Navigation & Evidence Mode
# When true (default), shows "Evidence & Audit" section (Test Results & Automation Log) in sidebar navigation.
# When false, hides the audit pages for a streamlined researcher workflow.
SHOW_EVIDENCE_PAGES=true

# Privacy & Multi-Tenant Data Governance
# RETENTION_DAYS: Automatic purging of records and report files older than N days (default 30)
RETENTION_DAYS=30

# Admin Access Mode
# When true, enables administrative inspection in sidebar (protected by ADMIN_PASSWORD).
# Never shown in standard user navigation.
ADMIN_MODE=false
ADMIN_PASSWORD=change_this_admin_password_in_production
